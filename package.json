{
  "name": "aion2calc-script-checks",
  "private": true,
  "description": "Lint and formatting for the app's and the website's scripts, which ship as they are written (no build step).",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "espree": "11.2.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
