# systemd unit for the aion2calc log server.
# Install: sudo cp aion2calc-logs.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now aion2calc-logs
[Unit]
Description=aion2calc log server (AION 2 combat logs, a2log uploads)
After=network.target

[Service]
User=a2logs
Group=a2logs
WorkingDirectory=/opt/aion2calc
Environment=A2LOGS_DATA=/var/lib/aion2calc-logs
Environment=A2LOGS_HOST=127.0.0.1
Environment=A2LOGS_PORT=8780
Environment=A2LOGS_PUBLIC_URL=https://logs.example.com
Environment=A2LOGS_TRUST_PROXY=1
Environment=A2LOGS_ALLOW_ANONYMOUS=0
Environment=A2LOGS_MAX_MB=25
Environment=A2LOGS_UPLOADS_PER_HOUR=120
Environment=A2LOGS_NAME=aion2calc logs
Environment=AION2CALC_HOME=/var/lib/aion2calc-logs/aion2calc
ExecStart=/opt/aion2calc/venv/bin/python -m aion2calc.logserver serve
Restart=on-failure
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aion2calc-logs
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
